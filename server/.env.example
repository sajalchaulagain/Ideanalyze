# ---------------------------------------------------------------------------
# Ideanalyze API environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Node environment. Use "production" on Render so autoIndex is disabled and
# startup safety checks are enforced.
NODE_ENV=development

# Port the Express server listens on. Render supplies PORT automatically.
PORT=5000

# MongoDB Atlas connection string, for example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ideanalyze?retryWrites=true&w=majority
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/ideanalyze?retryWrites=true&w=majority

# Secret used to sign JWTs. Must be a long random value in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_generate_a_real_secret

# How long login tokens stay valid (jsonwebtoken duration syntax).
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS.
# Production example: https://your-site.netlify.app
# http://localhost:5173 is always allowed for local development.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# AI provider (optional until you use POST /api/ai/analyze)
#
# Gemini (default when AI_BASE_URL is empty):
#   AI_API_KEY=<your Google Gemini API key>
#   AI_MODEL=gemini-flash-lite-latest
#
# OpenAI-compatible provider:
#   AI_BASE_URL=https://your-provider.example/v1
#   AI_API_KEY=<provider key, often starts with sk->
#   AI_MODEL=<provider model id>
#
# There is no hardcoded third-party fallback: if a key is missing or an
# OpenAI-compatible key has no AI_BASE_URL, the API returns 503 and never
# sends the key anywhere.
# ---------------------------------------------------------------------------
AI_BASE_URL=
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-flash-lite-latest
AI_FALLBACK_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=25000

# Only used when AI_MODEL itself is a full URL (legacy configuration).
AI_MODEL_NAME=

# Request-rate limiting defaults for the API layer.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
