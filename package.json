{
  "name": "hackathon-practice-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:server": "npm --prefix frontend/server run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install --prefix frontend && npm install --prefix frontend/server && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
